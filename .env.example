# Copy to .env and fill. The worker (pipeline) needs the AI/image keys; the API
# needs none beyond the DB path (set by compose). Keep this file secret-free.

# --- AI rewrite / enrich (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
REWRITE_LANG=zh-Hant

# --- Cover image generation + storage (fill whichever your pipeline uses) ---
IMAGE_API_KEY=
IMAGE_API_BASE=
IMAGE_MODEL=
GEMINI_API_KEY=
# image hosting: Cloudinary OR R2
CLOUDINARY_URL=
CLOUDINARY_FOLDER=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- optional ---
EXA_API_KEY=
IMG_GEN_LIMIT=40

# DB path inside the container (compose sets this; override for an external DB).
HOTSPOT_DB_PATH=/app/data/hotspots.db
